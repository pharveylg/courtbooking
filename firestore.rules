rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to validate tenant ID format
    function isValidTenantId(tenantId) {
      return tenantId is string && 
             tenantId.size() > 0 && 
             tenantId.size() <= 50 &&
             tenantId.matches('^[a-z0-9-]+$');
    }
    
    // Helper function to check if request is for the correct tenant
    function isTenantContext(tenantId) {
      return isValidTenantId(tenantId) && 
             request.resource.data.keys().hasAny(['__tenant__']) == false; // Prevent tenant field injection
    }
    
    /* ---------- B5: Platform Admin permission groups ----------
       Two account shapes exist:
       - superadmin custom claim  = platform owner, every permission
         (grandfathered -- all original accounts keep working unchanged)
       - platformPerms ARRAY claim = scoped staff; each entry is one
         permission from the registry documented in superadmin.html
         (PLATFORM_PERMISSIONS) and SUPERADMIN_GUIDE.md. Grant via
         `node set-superadmin-claim.js <email> --perms a,b,c`.
       Rules and the console share this single vocabulary. */
    function isPlatformStaff() {
      return request.auth != null &&
             (request.auth.token.superadmin == true ||
              ('platformPerms' in request.auth.token));
    }
    function platformPerm(perm) {
      return request.auth != null &&
             (request.auth.token.superadmin == true ||
              (('platformPerms' in request.auth.token) &&
               (perm in request.auth.token.platformPerms)));
    }
    /* Tenant registry/usage/events reads used to be gated by isPlatformStaff()
       alone -- true for ANY signed-in staff member holding even one unrelated
       permission (e.g. manage_support, whose entire job is the Feature Ideas
       scratchpad, or view_platform_audit, whose job is the audit log) -- so
       a support-scoped or audit-only account could still read every
       tenant's credit balance, billing formula, and usage/events ledger. The
       console's own tab-visibility model (TAB_PERMS in superadmin.html) says
       who actually needs this: every tab except Feature Ideas and Security
       reads the shared tenant list, so every permission below it lists a
       tab is included here; manage_support, view_platform_audit, and
       manage_platform_configuration (which has no tab at all) are not. */
    function canReadTenantData() {
      return platformPerm('manage_organizations') ||
             platformPerm('manage_entitlements') ||
             platformPerm('manage_plans') ||
             platformPerm('view_platform_billing') ||
             platformPerm('verify_platform_payment') ||
             platformPerm('issue_platform_credit') ||
             platformPerm('view_platform_usage') ||
             platformPerm('diagnose_access');
    }

    // Support/planning notes ("Feature Ideas" tab) -- manage_support.
    match /platformFeatureIdeas/{ideaId} {
      allow read, write: if platformPerm('manage_support');
    }

    // Superadmin action audit log. Append-only from the app's perspective --
    // create is allowed so every mutating superadmin action can log itself,
    // but update/delete are explicitly denied so a logged entry can't later
    // be edited or removed through the client.
    match /platformAuditLog/{entryId} {
      // Any platform staff action can log itself; reading the log is its
      // own permission so auditees aren't automatically auditors.
      allow create: if isPlatformStaff();
      allow read: if platformPerm('view_platform_audit');
      allow update, delete: if false;
    }

    // Plan catalog (platform commercial layer). Each plan is a priced,
    // versioned bundle: which products it includes, the monthly base fee,
    // the included confirmed-booking allowance, the per-booking overage
    // rate, court limits, and per-add-on monthly fees. Assigning a plan to
    // a tenant stamps its pricingVersion onto the tenant's subscription so
    // a later plan edit never rewrites history (versioned pricing).
    match /platformPlans/{planId} {
      allow read: if isPlatformStaff();
      allow write: if platformPerm('manage_plans');
    }

    // Platform invoices -- the billing domain's core document. Drafts are
    // generated from the usage events ledger with FROZEN line items (the
    // snapshot in each invoice explains every line), then walk the manual
    // payment states: draft -> awaiting_payment -> submitted_for_verification
    // -> verified / rejected / partially_paid / waived / cancelled. These
    // are platform-billing-only (what a tenant owes the platform) -- a
    // tenant's own revenue from its players is never written here.
    // Reads: superadmin/platform-staff only. A tenant-self-access branch
    // used to live here (`invoiceId.split('_')... == tenantId`), on the
    // theory that the id encoding the tenant was enough of a check -- but
    // slugs are public, so that let anyone who knew a facility's slug read
    // its invoices with no PIN, no auth, nothing. billing.html now gets
    // its own invoices through the getBillingPortalData callable
    // (functions/index.js), which verifies the tenant's PIN server-side
    // with the Admin SDK before returning anything, so this rule no
    // longer needs a client-readable path at all.
    // `list` stays superadmin-only so the collection can't be enumerated.
    // Writes: creating/deleting an invoice (issuing it, or removing one
    // entirely) is verify_platform_payment-only. Updates additionally
    // accept issue_platform_credit, but ONLY for the exact fields the
    // console's "apply credit to invoice" action touches (status,
    // creditsApplied, payments, verifiedAt) -- a credit-only holder still
    // can't touch `lines`, `total`, `tenantId`, etc., or use `update` to
    // do the things verify_platform_payment actually gates (recording a
    // cash payment, rejecting, waiving, cancelling). This mirrors
    // issue_platform_credit's own stated purpose ("apply credit to
    // invoices") -- see the platformTenants comment below for why this
    // field-scoping exists at all.
    match /platformInvoices/{invoiceId} {
      allow get: if platformPerm('view_platform_billing') || platformPerm('verify_platform_payment');
      allow list: if platformPerm('view_platform_billing') || platformPerm('verify_platform_payment');
      allow create, delete: if platformPerm('verify_platform_payment');
      allow update: if platformPerm('verify_platform_payment')
                   || (platformPerm('issue_platform_credit')
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'creditsApplied', 'payments', 'updatedAt', 'verifiedAt']));
    }

    // Platform settings key-value docs (currently just billing/payment
    // instructions: where tenants pay, GCash/bank details, QR image).
    // Writes are superadmin-only. Reads are public by design: the
    // tenant-facing billing portal (billing.html) has to show these
    // instructions to the person paying -- same class of publicly
    // readable business info as the tenantDirectory collection.
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if platformPerm('manage_platform_configuration');
    }

    // Payer-submitted payment claims for platform invoices (the manual QR
    // loop, roadmap-style payment_submissions). Anyone in a tenant's
    // billing portal can SUBMIT a claim (method, reference, amount, proof
    // URL) -- but a submission is only ever a claim: it never moves an
    // invoice's status by itself. Only a superadmin review does, via the
    // console's verification queue. Reads mirror the app's existing
    // proofs/ posture (reference numbers are no more sensitive than the
    // already-public payment-proof bucket); update/delete are superadmin-
    // only so a claim can't be edited or withdrawn after the fact --
    // rejection is recorded on the submission, not by deleting it.
    match /platformSubmissions/{submissionId} {
      allow read, create: if true;
      allow update, delete: if platformPerm('verify_platform_payment');
    }


    // Platform-level tenant registry, used by the superadmin console.
    // Writes are superadmin-only. Reads are superadmin/platform-staff
    // only. A tenant-self `get` branch (`isValidTenantId(tenantId)`) used
    // to live here so billing.html could show a tenant its own plan,
    // subscription, billing formula, and prepaid balance -- but that
    // condition only checks the SLUG'S FORMAT, not that the caller ever
    // proved PIN knowledge, and slugs are public. Proven live: an
    // unauthenticated REST call to this path returned another tenant's
    // real creditBalance and billing formula. billing.html now reaches
    // this data through the getBillingPortalData callable
    // (functions/index.js), which checks the tenant's PIN server-side
    // (Admin SDK, not gated by these rules) first. `list` stays
    // superadmin-only.
    // The entitlements/ subcollection (one doc per product: booking,
    // store, tournament) inherits these rules -- product entitlement
    // lifecycle and history are platform-controlled state.
    match /platformTenants/{tenantId} {
      allow get: if canReadTenantData();
      allow list: if canReadTenantData();
      // Creating or deleting a tenant registry doc entirely (provisioning,
      // offboarding) stays manage_organizations-only -- but a plain
      // `allow write` here made every OTHER permission that names this
      // doc a lie: manage_plans's own description says "assign plans,
      // edit billing formulas" and issue_platform_credit's says "top up
      // prepaid balances and apply credit to invoices", yet a staff
      // member holding ONLY that permission (no manage_organizations)
      // got a clean permission-denied from Firestore the moment the
      // console tried to write `subscription`/`billing` or
      // `creditBalance` here -- console requirePerm() checks and these
      // rules were checking two different vocabularies for the same
      // write. Field-scoping each permission to the exact keys its own
      // console action touches (assignPlanToTenant/data-save-billing for
      // manage_plans; data-top-up/apply-charge/apply-credit-to-invoice
      // for issue_platform_credit and verify_platform_payment) closes
      // that gap without widening what any of them can touch beyond it.
      allow create, delete: if platformPerm('manage_organizations');
      allow update: if platformPerm('manage_organizations')
                   || (platformPerm('manage_plans')
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['subscription', 'billing', 'updatedAt']))
                   || ((platformPerm('issue_platform_credit') || platformPerm('verify_platform_payment'))
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['creditBalance', 'updatedAt']));

      // Product entitlements are their own permission family (B5): an
      // entitlements operator doesn't need full organization management.
      match /entitlements/{productId} {
        allow read: if canReadTenantData();
        allow write: if platformPerm('manage_entitlements');
      }

      // Usage counters (page views, etc.) are written by every ordinary
      // tenant visitor as they use the app, not just the superadmin, so
      // this subcollection needs its own, more open write rule. A
      // tenant-self read branch used to live here for the same reason
      // (and with the same flaw) as platformTenants/{tenantId} and
      // events/ below -- reads require actual platform-staff scope now
      // (canReadTenantData()), not just any signed-in staff member.
      match /usage/{period} {
        allow read: if canReadTenantData();
        allow write: if isValidTenantId(tenantId);
      }

      // Append-only usage event ledger (booking confirmed/cancelled, queue
      // session created, open play created) -- contains real player
      // emails (see index.html's logUsageEvent calls). Ordinary visitors
      // still write these as the app is used, but reads were the other
      // half of the proven exposure: an unauthenticated REST query
      // against this path returned live events with a player's email.
      // The tenant's own billing portal now gets a booking COUNT from
      // getBillingPortalData (functions/index.js) instead of reading
      // these documents directly, so the PII in this ledger never has to
      // leave the server. Reads require actual platform-staff scope
      // (canReadTenantData()), not just any signed-in staff member.
      match /events/{eventId} {
        allow read: if canReadTenantData();
        allow write: if isValidTenantId(tenantId);
      }
    }

    // Multi-tenant collections: clients/{clientId}/...
    match /clients/{clientId} {
      // Only allow access if clientId is valid
      allow read, write: if isValidTenantId(clientId);
      
      // Config subcollection
      match /config/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Suspend/pause status -- deliberately its own doc, NOT part of the
      // open-write config/ above. Publicly readable (every visitor's
      // browser needs to check it), but only a superadmin can flip it.
      // Keeping this the same open rule as config/ would mean anyone who
      // knows a tenant's slug could pause (or un-pause) that tenant with a
      // raw Firestore write, with no auth at all -- these are the fields
      // in this app where "which tenant" isn't a sufficient check; "who is
      // asking" matters too. Holds bookingPaused plus storeEnabled/
      // storePaused for the Pickle Court Store add-on -- two independent
      // per-product entitlements in the same doc, each toggled without
      // touching the other, by design.
      match /status/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if request.auth != null && request.auth.token.superadmin == true;
      }

      // Courts subcollection
      match /courts/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Settings subcollection (including PIN)
      match /settings/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Store settings (Store PIN, separate from the Booking Admin PIN in
      // settings/ above) -- same open per-tenant trust level as every other
      // operational doc; only the entitlement itself (status/ above) is
      // superadmin-gated.
      match /storeSettings/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Pickle Court Store: product catalog (single array doc, same
      // pattern as courts/pricing), sales ledger, and inventory movement
      // log (one doc per entry, same reasoning as the platform events
      // ledger -- append-heavy, no benefit to loading full history just
      // to make a sale). Same open per-tenant trust level as the rest of
      // this app; only the Store entitlement itself is superadmin-gated.
      match /storeProducts/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      match /storeSales/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      match /storeInventoryLog/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Store cash-reconciliation shifts (open/close register, one doc
      // per shift). Same open per-tenant trust level as every other Store
      // collection above.
      match /storeShifts/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Bookings subcollection
      match /bookings/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Open Play subcollection
      match /openPlay/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Morning subcollection
      match /morning/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Staff Reserve subcollection
      match /staffReserve/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Pricing subcollection
      match /pricing/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Per-court operating-hours overrides (queue/booking window, closing
      // time). Falls back to config/state's tenant-wide "hours" for any
      // court without an entry here.
      match /courtHours/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Queues subcollection
      match /queues/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Open Games subcollection (public matchmaking) -- one doc per game
      // rather than a single state doc, so joins can be scoped Firestore
      // transactions. Same open per-tenant rule as every other subcollection
      // here; there is no user auth in this app to gate on further.
      match /openGames/{gameId} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Soft abuse-limiting counters for Open Games creation
      match /abuseTracking/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Proofs subcollection
      match /proofs/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Pickle Court Tournaments: entitlement flags (tournamentEnabled/
      // tournamentPaused) live on status/state above, alongside Booking's
      // and Store's -- independent per-product, superadmin-only writes.
      //
      // Tournament/division metadata, registrations, participants, gallery
      // photos and upload tokens follow this app's existing open-per-tenant
      // trust level (no auth system exists to gate further on, same as
      // every collection above).
      match /tournaments/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      match /tournaments/{tournamentId}/divisions/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      match /tournaments/{tournamentId}/registrations/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      match /tournaments/{tournamentId}/participants/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      match /tournaments/{tournamentId}/photos/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      match /tournaments/{tournamentId}/uploadTokens/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Matches and standings are the one place in this whole app where a
      // direct client write is deliberately NOT allowed. A bracket's next
      // round is literally built from the previous round's recorded
      // winners -- two browsers racing to "advance" from stale local state
      // can corrupt the tree's structure, not just its data, and unlike a
      // fake booking or sale this isn't easily reversible. These are
      // written only by trusted (Admin SDK) server code -- see the
      // tournament engine's Cloud Functions, not shipped in this phase.
      // Reads stay open, matching the rest of the app.
      match /tournaments/{tournamentId}/matches/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if false;
      }
      match /tournaments/{tournamentId}/standings/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if false;
      }

      // Append-only audit trail for tournament actions (score corrections,
      // withdrawals, cancellations) -- create allowed, update/delete denied,
      // same shape as platformAuditLog above.
      match /tournaments/{tournamentId}/auditLog/{document} {
        allow read: if isValidTenantId(clientId);
        allow create: if isValidTenantId(clientId);
        allow update, delete: if false;
      }

      // Match-alert plumbing, server-only (Admin SDK bypasses rules). pushSubs
      // holds device push endpoints and keys, so it must never be readable.
      match /tournaments/{tournamentId}/pushSubs/{document} {
        allow read, write: if false;
      }
      match /tournaments/{tournamentId}/notifyOutbox/{document} {
        allow read, write: if false;
      }
      match /tournaments/{tournamentId}/notifyState/{document} {
        allow read, write: if false;
      }
    }

    // What a tenant owes the platform for a tournament (rate card is set by
    // the superadmin on platformTenants.billing.tournament). Written only by
    // the Cloud Functions (sync job + override callable), read by the
    // console and the invoice generator. Never readable by tenants.
    match /platformTournamentCharges/{chargeId} {
      allow get, list: if platformPerm('view_platform_billing')
                       || platformPerm('verify_platform_payment')
                       || platformPerm('manage_plans');
      allow write: if false;
    }

    // Tournaments the alert job scans -- server-only.
    match /platformLiveTournaments/{document} {
      allow read, write: if false;
    }

    // Public tenant directory -- used by the tenant picker on first launch.
    // Anyone can read (to show the list of available facilities), but only
    // superadmin can write (add/remove/update tenants in the directory).
    match /tenantDirectory/{tenantId} {
      allow read: if true;
      allow write: if platformPerm('manage_organizations');
    }

    // Cross-tenant player identity, keyed by a phone-derived id -- reused
    // across tenants so a dual-meet or a player with membership at two
    // clubs is the same record, not a duplicate per tenant. This app has
    // no per-person auth system to gate reads/writes on (same limitation
    // as every collection above), so the one enforceable boundary rules
    // can actually give here is used: `get` (fetch a single already-known
    // id) is allowed, but `list` (browse/scan every player) is denied --
    // a lookup still requires already knowing/deriving the id from a
    // phone number, it just can't be used to enumerate the collection.
    match /platformPlayers/{playerId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // Legacy single-tenant structure (for backward compatibility during migration)
    // WARNING: These should be removed once all clients are migrated to multi-tenant
    match /bookings/{document} {
      allow read, write: if true;
    }
    
    match /openPlay/{document} {
      allow read, write: if true;
    }
    
    match /morning/{document} {
      allow read, write: if true;
    }
    
    match /staffReserve/{document} {
      allow read, write: if true;
    }
    
    match /settings/{document} {
      allow read, write: if true;
    }
    
    match /queues/{document} {
      allow read, write: if true;
    }
    
    match /courts/{document} {
      allow read, write: if true;
    }
    
    match /proofs/{document} {
      allow read, write: if true;
    }
  }
}
