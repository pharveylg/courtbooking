rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to validate tenant ID format
    function isValidTenantId(tenantId) {
      return tenantId is string && 
             tenantId.size() > 0 && 
             tenantId.size() <= 50 &&
             tenantId.matches('^[a-z0-9-]+$');
    }
    
    // Helper function to check if request is for the correct tenant
    function isTenantContext(tenantId) {
      return isValidTenantId(tenantId) && 
             request.resource.data.keys().hasAny(['__tenant__']) == false; // Prevent tenant field injection
    }
    
    // Platform-level tenant registry, used by the superadmin console.
    // Only accounts with the "superadmin" custom claim (set via
    // set-superadmin-claim.js) may read or write this collection.
    match /platformTenants/{tenantId} {
      allow read, write: if request.auth != null && request.auth.token.superadmin == true;

      // Usage counters (page views, etc.) are written by every ordinary
      // tenant visitor as they use the app, not just the superadmin, so
      // this subcollection needs its own, more open write rule. Reads
      // stay superadmin-only -- this feeds billing/costing.
      match /usage/{period} {
        allow read: if request.auth != null && request.auth.token.superadmin == true;
        allow write: if isValidTenantId(tenantId);
      }

      // Append-only usage event ledger (booking confirmed/cancelled, queue
      // session created, open play created). Same reasoning as /usage:
      // ordinary visitors write these as the app is used; only superadmin
      // reads them. This is the source of truth for confirmed-bookings
      // billing and every derived analytic, kept as discrete events (not
      // just a running total) so history survives even after the
      // originating booking is pruned from clients/{tenantId}/bookings.
      match /events/{eventId} {
        allow read: if request.auth != null && request.auth.token.superadmin == true;
        allow write: if isValidTenantId(tenantId);
      }
    }

    // Multi-tenant collections: clients/{clientId}/...
    match /clients/{clientId} {
      // Only allow access if clientId is valid
      allow read, write: if isValidTenantId(clientId);
      
      // Config subcollection
      match /config/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Courts subcollection
      match /courts/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Settings subcollection (including PIN)
      match /settings/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Bookings subcollection
      match /bookings/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Open Play subcollection
      match /openPlay/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Morning subcollection
      match /morning/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Staff Reserve subcollection
      match /staffReserve/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Pricing subcollection
      match /pricing/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Queues subcollection
      match /queues/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Open Games subcollection (public matchmaking) -- one doc per game
      // rather than a single state doc, so joins can be scoped Firestore
      // transactions. Same open per-tenant rule as every other subcollection
      // here; there is no user auth in this app to gate on further.
      match /openGames/{gameId} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Soft abuse-limiting counters for Open Games creation
      match /abuseTracking/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }

      // Proofs subcollection
      match /proofs/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
    }
    
    // Legacy single-tenant structure (for backward compatibility during migration)
    // WARNING: These should be removed once all clients are migrated to multi-tenant
    match /bookings/{document} {
      allow read, write: if true;
    }
    
    match /openPlay/{document} {
      allow read, write: if true;
    }
    
    match /morning/{document} {
      allow read, write: if true;
    }
    
    match /staffReserve/{document} {
      allow read, write: if true;
    }
    
    match /settings/{document} {
      allow read, write: if true;
    }
    
    match /queues/{document} {
      allow read, write: if true;
    }
    
    match /courts/{document} {
      allow read, write: if true;
    }
    
    match /proofs/{document} {
      allow read, write: if true;
    }
  }
}
