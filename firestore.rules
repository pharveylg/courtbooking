rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to validate tenant ID format
    function isValidTenantId(tenantId) {
      return tenantId is string && 
             tenantId.size() > 0 && 
             tenantId.size() <= 50 &&
             tenantId.matches('^[a-z0-9-]+$');
    }
    
    // Helper function to check if request is for the correct tenant
    function isTenantContext(tenantId) {
      return isValidTenantId(tenantId) && 
             request.resource.data.keys().hasAny(['__tenant__']) == false; // Prevent tenant field injection
    }
    
    // Platform-level tenant registry, used by the superadmin console.
    // Only accounts with the "superadmin" custom claim (set via
    // set-superadmin-claim.js) may read or write this collection.
    match /platformTenants/{tenantId} {
      allow read, write: if request.auth != null && request.auth.token.superadmin == true;
    }

    // Multi-tenant collections: clients/{clientId}/...
    match /clients/{clientId} {
      // Only allow access if clientId is valid
      allow read, write: if isValidTenantId(clientId);
      
      // Config subcollection
      match /config/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Courts subcollection
      match /courts/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Settings subcollection (including PIN)
      match /settings/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Bookings subcollection
      match /bookings/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Open Play subcollection
      match /openPlay/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Morning subcollection
      match /morning/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Staff Reserve subcollection
      match /staffReserve/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Queues subcollection
      match /queues/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
      
      // Proofs subcollection
      match /proofs/{document} {
        allow read: if isValidTenantId(clientId);
        allow write: if isValidTenantId(clientId);
      }
    }
    
    // Legacy single-tenant structure (for backward compatibility during migration)
    // WARNING: These should be removed once all clients are migrated to multi-tenant
    match /bookings/{document} {
      allow read, write: if true;
    }
    
    match /openPlay/{document} {
      allow read, write: if true;
    }
    
    match /morning/{document} {
      allow read, write: if true;
    }
    
    match /staffReserve/{document} {
      allow read, write: if true;
    }
    
    match /settings/{document} {
      allow read, write: if true;
    }
    
    match /queues/{document} {
      allow read, write: if true;
    }
    
    match /courts/{document} {
      allow read, write: if true;
    }
    
    match /proofs/{document} {
      allow read, write: if true;
    }
  }
}
