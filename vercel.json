{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/superadmin.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/store.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/tournament-admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/tournament.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/gallery.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/tailwind.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/icons/(.*)", "destination": "/icons/$1" },
    { "source": "/superadmin", "destination": "/superadmin.html" },
    { "source": "/superadmin.html", "destination": "/superadmin.html" },
    { "source": "/store", "destination": "/store.html" },
    { "source": "/store.html", "destination": "/store.html" },
    { "source": "/tournament-admin", "destination": "/tournament-admin.html" },
    { "source": "/tournament-admin.html", "destination": "/tournament-admin.html" },
    { "source": "/tournament", "destination": "/tournament.html" },
    { "source": "/tournament.html", "destination": "/tournament.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/gallery.html", "destination": "/gallery.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
